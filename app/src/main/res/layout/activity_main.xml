<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- 连接表单 -->
    <LinearLayout
        android:id="@+id/form"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">
        <EditText android:id="@+id/host" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="主机 IP / 域名" android:inputType="textUri" android:textColor="#FFFFFF" android:textColorHint="#888888" />
        <EditText android:id="@+id/port" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="端口" android:text="22" android:inputType="number" android:textColor="#FFFFFF" android:textColorHint="#888888" />
        <EditText android:id="@+id/user" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="用户名" android:inputType="textVisiblePassword" android:textColor="#FFFFFF" android:textColorHint="#888888" />
        <EditText android:id="@+id/pass" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="密码" android:inputType="textPassword" android:textColor="#FFFFFF" android:textColorHint="#888888" />
        <Button android:id="@+id/connect" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="连接" />
        <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingTop="12dp" android:textColor="#FF6B6B" />
    </LinearLayout>

    <!-- 终端 -->
    <LinearLayout
        android:id="@+id/term"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">
        <ScrollView android:id="@+id/scroll" android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1">
            <TextView android:id="@+id/screen" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:padding="6dp" android:typeface="monospace" android:textSize="13sp"
                android:textColor="#E0E0E0" android:textIsSelectable="true" />
        </ScrollView>
        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:scrollbars="none">
            <LinearLayout android:id="@+id/keys" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:orientation="horizontal" />
        </HorizontalScrollView>
        <EditText android:id="@+id/input" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="输入命令，回车发送" android:singleLine="true" android:imeOptions="actionSend"
            android:inputType="textVisiblePassword" android:textColor="#FFFFFF" android:textColorHint="#888888" />
    </LinearLayout>
</FrameLayout>
